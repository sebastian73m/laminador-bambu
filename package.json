{
  "name": "laminador-chatgpt",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.viewer.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "demo": "tsx src/server.ts --demo",
    "package": "node scripts/package.mjs",
    "format": "prettier --write src viewer tests scripts/*.mjs *.json *.ts",
    "format:check": "prettier --check src viewer tests scripts/*.mjs *.json *.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.2.1",
    "three": "0.186.1",
    "yauzl": "3.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.183.0",
    "@types/yauzl": "^2.10.3",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "8.3.3",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastian73m/laminador-bambu.git"
  },
  "homepage": "https://github.com/sebastian73m/laminador-bambu#readme",
  "bugs": {
    "url": "https://github.com/sebastian73m/laminador-bambu/issues"
  }
}
